rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin check ─────────────────────────────────────────────────────────
    // ตรวจจาก email ที่ verify แล้วของ Google account
    // เพิ่ม/ลบ admin: แก้ list นี้ + src/lib/admin-config.ts ให้ตรงกัน
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['aomjai.4040@gmail.com'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Exams ───────────────────────────────────────────────────────────────
    // อ่านได้เฉพาะชุดที่ publish (หน้าแรกไม่ต้อง login) | เขียนได้เฉพาะ admin
    match /exams/{examId} {
      allow read:  if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();

      match /questions/{questionId} {
        // เอกสารมี correctAnswer+explanation — ปิดไม่ให้ client อ่านตรง
        // ผู้เรียนใช้ผ่าน /api/exam/* (โจทย์ไม่มีเฉลย, ตรวจคะแนนบน server,
        // เฉลยเปิดหลังส่งคำตอบ) — เหลือ admin สำหรับหน้าแก้ไข/วิเคราะห์
        allow read:  if isAdmin();
        allow write: if isAdmin();
      }
    }

    // ── Activation codes ────────────────────────────────────────────────────
    // ผู้ใช้: อ่านเพื่อ activate + update ได้เฉพาะ usedCount ทีละ +1 เท่านั้น
    // สร้าง/ลบ/แก้อย่างอื่น: admin เท่านั้น
    match /activationCodes/{codeId} {
      allow read:   if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
            && request.resource.data.usedCount == resource.data.usedCount + 1);
    }

    // ── User courses ────────────────────────────────────────────────────────
    // สร้างได้เฉพาะของตัวเอง และต้องอ้างอิง activation code ที่มีจริง + active
    // + code string/courseId ตรงกับเอกสาร code + ยังไม่หมดอายุ
    match /userCourses/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.codeId is string
        && get(/databases/$(database)/documents/activationCodes/$(request.resource.data.codeId)).data.status == 'active'
        && get(/databases/$(database)/documents/activationCodes/$(request.resource.data.codeId)).data.code == request.resource.data.activationCode
        && get(/databases/$(database)/documents/activationCodes/$(request.resource.data.codeId)).data.courseId == request.resource.data.courseId
        && (get(/databases/$(database)/documents/activationCodes/$(request.resource.data.codeId)).data.expiresAt == null
            || get(/databases/$(database)/documents/activationCodes/$(request.resource.data.codeId)).data.expiresAt > request.time);

      allow update, delete: if isAdmin();
    }

    // ── Users + subcollections ──────────────────────────────────────────────
    // อ่าน/เขียนได้เฉพาะของตัวเอง (admin อ่านได้เพื่อ analytics)
    match /users/{userId} {
      allow read:  if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isSignedIn() && request.auth.uid == userId;

      // ครอบคลุม examSummaries, results, fcProgress, fcDeckStats ฯลฯ
      match /{subcol}/{docId} {
        allow read:  if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ── Admin analytics: อ่าน history ทุกคนแบบ collection group ─────────────
    // ใช้นับ "มีกี่คนที่ทำข้อสอบแล้ว" ในหน้า /admin/users
    match /{path=**}/history/{docId} {
      allow read: if isAdmin();
    }

    // อุปกรณ์ที่แต่ละบัญชีใช้ (log จาก device-session) — admin ตรวจการแชร์บัญชี
    // delete: แอดมินล้างรายการเครื่องให้ลูกค้าที่เปลี่ยนเครื่องใหม่
    match /{path=**}/devices/{deviceId} {
      allow read, delete: if isAdmin();
    }

    // ── Results ─────────────────────────────────────────────────────────────
    // สร้าง/อ่านรายชิ้น: ผู้ที่ login | list/แก้/ลบ: admin (หน้า analytics)
    match /results/{resultId} {
      allow create: if isSignedIn();
      allow get:    if isSignedIn();
      allow list, update, delete: if isAdmin();
    }

    // ── Flash Card Decks / Cards ────────────────────────────────────────────
    // login แล้วอ่านได้ทั้งหมด (มี query by slug ที่ไม่กรอง published)
    // ไม่ login อ่านได้เฉพาะที่ publish | เขียน: admin เท่านั้น
    match /flashcardDecks/{deckId} {
      allow read:  if isSignedIn() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    match /flashcards/{cardId} {
      allow read:  if isSignedIn() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    // ── Orders (คำสั่งซื้อในเว็บ) ────────────────────────────────────────────
    // สร้าง/ยืนยันทำผ่าน server (Admin SDK) เท่านั้น — client อ่านของตัวเองได้
    match /orders/{orderId} {
      allow read:  if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin(); // server ใช้ Admin SDK ข้าม rules; ปิด client write
    }
    // กันสลิปซ้ำ — server เท่านั้น
    match /usedSlips/{ref} {
      allow read, write: if isAdmin();
    }

    // ── Course Videos ───────────────────────────────────────────────────────
    // เก็บ YouTube id ของวิดีโอคอร์สเต็ม — อ่านได้เมื่อ login
    // ยกเว้น "คลิปตัวอย่างฟรี" (isSample && isPublished) เปิดอ่านสาธารณะ
    // เพื่อให้คนยังไม่ล็อกอินดูตัวอย่างได้ตอนแชร์ลิงก์โปรโมท (query ต้องกรอง
    // isSample==true && isPublished==true ให้ทุก doc ที่คืนตรงเงื่อนไข rule)
    // NOTE: การกรอง tier (App Only ห้ามดู) ทำฝั่ง client ตอนนี้;
    // การบังคับระดับ DB ต้องรอ server API (Phase 3) เช่นเดียวกับเฉลยข้อสอบ
    match /videos/{videoId} {
      allow read:  if isSignedIn()
                   || (resource.data.isSample == true && resource.data.isPublished == true);
      allow write: if isAdmin();
    }

    // ── MOPH Focus ──────────────────────────────────────────────────────────
    // หน้า user query ทั้ง collection แล้วกรอง client-side → ต้องอ่านได้เมื่อ login
    match /mophFocus/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
